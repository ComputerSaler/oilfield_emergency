    font-size: var(--of-font-size-base);
    color: var(--of-text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .modal-hint-sm {
    font-size: var(--of-font-size-xs);
    color: var(--of-text-tertiary);
    font-weight: var(--of-font-weight-normal);
  }
}

